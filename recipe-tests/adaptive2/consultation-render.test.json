            "repeat": true,
            "behavior": {
              "mode": "passthrough"
            }
          }
        ]
      },
      "assertions": [
        {
          "type": "cel_true",
          "expr": "outputs.content[\"conversation.md\"].startsWith(\"# notebook and storage: Conversation\\n\\n\")"
        },
        {
          "type": "cel_true",
          "expr": "!(\"summary.md\" in outputs.content)"
        },
        {
          "type": "cel_true",
          "expr": "outputs.content[\"conversation.md\"] == \"# notebook and storage: Conversation\\n\\n\""
        },
        {
          "type": "cel_true",
          "expr": "calls.filter(c,c.node_path.contains(\"read_document_headings\")).size() == 0"
        },
        {
          "type": "cel_true",
          "expr": "!calls.exists(c,c.node_path.contains(\"read_document_headings\") && c.artifacts.exists(k,k.endsWith(\"conversation.json\")))"
        },
        {
          "type": "cel_true",
          "expr": "outputs.documents.all(k,outputs.documents[k].kind == \"value\" && outputs.documents[k].format == \"text\" && outputs.documents[k].name == k)"
        },
        {
