{
  "recipe": "recovery-approval-guards.yaml",
  "cases": [
    {
      "id": "wrong-cell-source",
      "type": "integration_case",
      "inputs": {
        "source_cell": "storage"
      },
      "runtime": {
        "cells": {
          "root": {
            "file_sources": {
              ".c2/recipes/terminal-source.yaml": "terminal-source.yaml"
            }
          },
          "storage": {
            "file_sources": {
              ".c2/recipes/terminal-source.yaml": "terminal-source.yaml"
            }
          }
        }
      },
      "mocks": {
        "ops": [
          {
            "match": {
              "op": "command_execution"
            },
            "repeat": true,
            "behavior": {
              "mode": "passthrough"
            }
          }
        ]
      },
      "assertions": [
        {
          "type": "output_equals",
          "path": "valid",
          "value": false
        },
        {
          "type": "cel_true",
          "expr": "outputs.reason.contains(\"different cell\")"
        }
      ]
    },
    {
      "id": "missing-human-direction",
      "type": "integration_case",
      "inputs": {
        "source_cell": "root"
      },
      "runtime": {
        "cells": {
          "root": {
            "file_sources": {
              ".c2/recipes/terminal-source.yaml": "terminal-source.yaml"
            }
          },
          "storage": {
            "file_sources": {
              ".c2/recipes/terminal-source.yaml": "terminal-source.yaml"
            }
          }
        }
      },
      "mocks": {
        "ops": [
          {
            "match": {
              "op": "command_execution"
            },
            "repeat": true,
            "behavior": {
              "mode": "passthrough"
            }
          }
        ]
      },
      "assertions": [
        {
          "type": "output_equals",
          "path": "valid",
          "value": false
        },
        {
          "type": "cel_true",
          "expr": "outputs.reason.contains(\"No recorded human direction\")"
        }
      ]
    }
  ]
}
