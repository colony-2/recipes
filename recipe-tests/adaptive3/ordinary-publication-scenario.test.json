        "controls": {
          "scenario": {
            "jobs": {
              "root": {
                "root": true
              },
              "ordinary": {
                "child_binding": "ordinary"
              }
            },
            "admission_holds": [],
            "dispatch_holds": [
              {
                "id": "publish",
                "job": "ordinary",
                "task": {
                  "task_type": "recipe_workspace_resolve",
                  "node_path": "ordinary-scenario/execute/adaptive3-execute/publish/publish/adaptive3-hooks/publish/publish",
                  "attempt": 1,
                  "occurrence": 1
                },
                "disposition": "cancelled"
              }
            ],
            "events": [
              {
                "id": "publishing",
                "kind": "dispatch",
                "hold": "publish"
              },
              {
                "id": "landed",
                "kind": "task_result",
                "job": "ordinary",
                "task": {
                  "task_type": "merge:merge",
                  "node_path": "ordinary-scenario/execute/adaptive3-execute/merge/merge/adaptive3-integration/merge/sequence/merge",
                  "attempt": 1,
                  "occurrence": 1
                },
                "status": "SUCCEEDED"
              }
            ],
            "actions": [
              {
                "id": "cancel",
                "after_all": [
                  "publishing",
                  "landed"
                ],
                "do": "cancel_job",
                "target": "ordinary"
              }
            ],
            "outcomes": {
              "root": {
                "status": "completed"
              },
              "ordinary": {
                "status": "cancelled"
              }
            }
          },
          "dispatch": {
            "forbid": [
              {
                "job": "ordinary",
                "kind": "task",
                "name": "command_execution:command_execution",
                "node_path": "ordinary-scenario/execute/adaptive3-execute/publish/publish/adaptive3-hooks/publish/publish/invoke/ordinary-source/source"
              }
            ]
          }
        }
      },
      "mocks": {
        "ops": [
          {
            "match": {
              "node_path": "queue-scenario/spawn"
            },
            "behavior": {
              "mode": "return",
              "effects": {
                "children": [
                  {
                    "bind": "ordinary",
                    "cell": "root",
                    "recipe": "fixtures/queue-scenario/ordinary.yaml"
                  }
                ]
              }
            }
          },
          {
            "match": {
              "node_path": "queue-scenario/next"
            },
            "behavior": {
              "mode": "return"
            }
          },
          {
            "match": {
              "op": "command_execution"
            },
            "repeat": true,
            "behavior": {
              "mode": "passthrough"
            }
          },
          {
            "match": {
              "op": "squash"
            },
            "repeat": true,
            "behavior": {
              "mode": "passthrough"
            }
          },
          {
            "match": {
              "op": "merge"
            },
            "repeat": true,
            "behavior": {
              "mode": "passthrough"
            }
          }
        ]
      },
      "assertions": [
        {
          "type": "cel_true",
          "expr": "controls.scenario.complete && controls.dispatch_complete"
        },
        {
          "type": "cel_true",
          "expr": "calls.filter(c,c.op=='merge').size()==1 && !calls.exists(c,c.node_path.endsWith('/ordinary-source/source'))"
        }
      ]
    },
